# Single home for coverage config (pytest-cov reads it automatically).
# Measured 2026-11-02: 95.25% total (13635 stmts, 648 missed; 2602 passed, 16 skipped). Was 92.77% before the Garage/router tests.
# (Earlier: 2026-10-30 94.86%, 2305 tests.)
# Rule: fail_under = measured total rounded DOWN, minus 2 => 93. Only enforced when pytest runs
# with --cov (backend-tests job); the mysql-integration subset does not pass --cov, so it never
# hits the floor. Raise it by re-measuring and applying the same rule; never lower it to pass.
[run]
source = app

[report]
fail_under = 93
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
